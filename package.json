{
  "name": "agentcompany",
  "version": "0.1.0",
  "description": "Run Claude Code, Codex and Antigravity as a local AI dev team: tickets, independent review, evidence-gated completion and human approval. No API keys.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ldh0906/AgentCompany.git"
  },
  "homepage": "https://github.com/ldh0906/AgentCompany#readme",
  "bugs": "https://github.com/ldh0906/AgentCompany/issues",
  "type": "module",
  "bin": {
    "agent-company": "dist/cli/main.js",
    "aco": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "teams",
    "formulas",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node src/cli/main.ts demo --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node src/cli/main.ts start",
    "demo": "node src/cli/main.ts demo",
    "test": "npm run -s test:unit && npm run -s test:e2e",
    "test:e2e": "node --no-warnings --test --test-concurrency=2 \"test/e2e/**/*.test.ts\"",
    "test:unit": "node --no-warnings --test --test-concurrency=4 \"test/{adapters,agents,app,cli,core,runner,server,store,workspace}/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "build:exe": "node tools/build-exe.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"web/src/**/*.{ts,tsx,css}\""
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "multi-agent",
    "orchestrator",
    "code-review",
    "git-worktree",
    "local-first",
    "windows"
  ]
}
