{
  "name": "agentcompany",
  "version": "0.1.0",
  "description": "Run Claude Code, Codex and Antigravity as a local AI dev team: tickets, independent review, evidence-gated completion and human approval. No API keys.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "agent-company": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node src/cli/main.ts demo --no-open",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node src/cli/main.ts start",
    "demo": "node src/cli/main.ts demo",
    "test": "node --no-warnings --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "antigravity",
    "multi-agent",
    "orchestrator",
    "code-review",
    "git-worktree",
    "local-first",
    "windows"
  ]
}
